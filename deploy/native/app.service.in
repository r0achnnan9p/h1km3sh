# Replace @INSTANCE@ after choosing a name. Review and install manually on an isolated operator-owned host.
[Unit]
Description=Independent native staging application
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/@INSTANCE@-next/app.env

[Service]
Type=simple
User=@INSTANCE@-next
Group=@INSTANCE@-next
WorkingDirectory=/opt/@INSTANCE@-next/pointers/current
EnvironmentFile=/etc/@INSTANCE@-next/app.env
# Explicit preparation invariants override env-file values via the launcher.
ExecStart=/usr/local/bin/node scripts/native-start.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/@INSTANCE@-next

[Install]
WantedBy=multi-user.target

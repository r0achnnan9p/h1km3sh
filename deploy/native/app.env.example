# Install as root:root 0600. systemd reads this before switching to the app user.
# Replace every @INSTANCE@. Never commit the populated file.
# User must provide an existing secret file through a secure local setup.
# 1 = empty preparation. After explicit commissioning authorization, set 0 and
# restart BEFORE adding this instance's own sources. Never copy another deployment's state.
HIKCLIP_PREPARATION_ONLY=1
HIKVISION_DATA_DIR=/var/lib/@INSTANCE@-next/data
HIKVISION_DOWNLOADS_DIR=/var/lib/@INSTANCE@-next/downloads
HIKVISION_ARTIFACT_DIR=/var/lib/@INSTANCE@-next/data/artifacts
HIKVISION_ARCHIVE_DIR=/var/lib/@INSTANCE@-next/archive
HIKVISION_RUNTIME_FILE=/var/lib/@INSTANCE@-next/data/service/runtime.json
# Set to NVR timezone before any eventual device tests.
TZ=Asia/Shanghai
# Ubuntu 24.04 fonts-dejavu-core; needed for timeline labels.
HIKVISION_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
HIKCLIP_PUBLIC_PORT=30002
# If Caddy is on another machine: explicitly choose this NEW CT's LAN IP.
# Otherwise keep loopback. NEVER forward 30001.
HIKCLIP_PUBLIC_BIND=127.0.0.1
HIKCLIP_PUBLIC_BASE_URL=https://video.example.com/h1km3sh
# User fills an ordinary 8–128 character login password locally; no complexity rules.
# Empty here intentionally: no real secret belongs in the repository or CI.
HIKCLIP_LOGIN_PASSWORD=
# Absolute console login lifetime: 1–720 hours, default 720 (30 days).
# Normal restarts retain login; password or MCP-token changes revoke it.
# HIKCLIP_STATUS_SESSION_HOURS=720
# Independent MCP/OAuth/download-signing token, NOT the web login password.
# This separate file remains root:<instance>-next 0640 for the app to read.
HIKCLIP_MCP_TOKEN_FILE=/etc/@INSTANCE@-next/mcp-token

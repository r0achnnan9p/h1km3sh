# Private source-process configuration. Review and edit; no automatic .env loading.
# Start with: node --env-file=YOUR_PRIVATE_FILE server.js
HIKCLIP_BIND=127.0.0.1
HIKCLIP_PORT_FALLBACK=0
HIKCLIP_SCHEDULER_ENABLED=0
HIKVISION_MEDIAMTX_API_URL=
# Set TZ to the recorder's wall clock; this is only an example.
TZ=Asia/Shanghai
# Optional: replace these with private absolute paths for your own instance.
# HIKVISION_DATA_DIR=/absolute/private/data
# HIKVISION_DOWNLOADS_DIR=/absolute/private/downloads
# HIKVISION_ARTIFACT_DIR=/absolute/private/artifacts
# HIKVISION_ARCHIVE_DIR=/absolute/read-only/recordings
# HIKVISION_MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
# Protected gateway: supply real values separately before enabling remote access.
# HIKCLIP_PUBLIC_PORT=30002
# HIKCLIP_PUBLIC_BIND=127.0.0.1
# HIKCLIP_PUBLIC_BASE_URL=https://video.example.com/h1km3sh
# HIKCLIP_MCP_TOKEN_FILE=/absolute/private/mcp-token
# HIKCLIP_LOGIN_PASSWORD=
